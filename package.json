{
  "name": "haochi-snack-shop",
  "version": "1.0.0",
  "private": true,
  "description": "ХАОЧИ — интернет-магазин китайских снеков (рабочий макет)",
  "type": "module",
  "engines": { "node": ">=22.13" },
  "scripts": {
    "build": "node scripts/build.mjs",
    "start": "node --disable-warning=ExperimentalWarning server/server.mjs",
    "dev": "npm run build && npm start",
    "illustrations": "node scripts/gen-illustrations.mjs",
    "test": "npm run build && node --disable-warning=ExperimentalWarning --test 'tests/unit/*.test.mjs'",
    "test:e2e": "npm run build && node --disable-warning=ExperimentalWarning --test --test-concurrency=1 'tests/e2e/*.test.mjs'"
  },
  "devDependencies": {
    "esbuild": "^0.25.10",
    "playwright": "1.56.1"
  }
}
